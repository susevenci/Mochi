{
  "$defs": {
    "AsrErrorPayload": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "AsrErrorPayload",
      "type": "object"
    },
    "AsrFinalPayload": {
      "properties": {
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "language": {
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "AsrFinalPayload",
      "type": "object"
    },
    "AsrPartialPayload": {
      "properties": {
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "AsrPartialPayload",
      "type": "object"
    },
    "AudioInBeginPayload": {
      "properties": {
        "format": {
          "default": "pcm16",
          "title": "Format",
          "type": "string"
        },
        "mode": {
          "default": "push_to_talk",
          "title": "Mode",
          "type": "string"
        },
        "sample_rate": {
          "default": 16000,
          "maximum": 48000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "title": "AudioInBeginPayload",
      "type": "object"
    },
    "AudioInChunkPayload": {
      "properties": {
        "data": {
          "title": "Data",
          "type": "string"
        },
        "seq": {
          "default": 0,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "data"
      ],
      "title": "AudioInChunkPayload",
      "type": "object"
    },
    "AudioInEndPayload": {
      "properties": {
        "reason": {
          "default": "user",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "AudioInEndPayload",
      "type": "object"
    },
    "AudioOutBeginPayload": {
      "properties": {
        "format": {
          "default": "mp3",
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "default": 24000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "title": "AudioOutBeginPayload",
      "type": "object"
    },
    "AudioOutChunkPayload": {
      "properties": {
        "data": {
          "title": "Data",
          "type": "string"
        },
        "format": {
          "default": "mp3",
          "title": "Format",
          "type": "string"
        },
        "seq": {
          "default": 0,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "data"
      ],
      "title": "AudioOutChunkPayload",
      "type": "object"
    },
    "AudioOutEndPayload": {
      "properties": {},
      "title": "AudioOutEndPayload",
      "type": "object"
    },
    "AudioStopPayload": {
      "properties": {
        "reason": {
          "default": "user",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "AudioStopPayload",
      "type": "object"
    },
    "ChatAgentDeltaPayload": {
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "string"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        },
        "index": {
          "default": 0,
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "delta"
      ],
      "title": "ChatAgentDeltaPayload",
      "type": "object"
    },
    "ChatAgentFinalPayload": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "emotion": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotion"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "first_token_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token Ms"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "route"
      ],
      "title": "ChatAgentFinalPayload",
      "type": "object"
    },
    "ChatInterruptPayload": {
      "properties": {
        "reason": {
          "default": "user",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "ChatInterruptPayload",
      "type": "object"
    },
    "ChatUserInputPayload": {
      "properties": {
        "modality": {
          "default": "text",
          "title": "Modality",
          "type": "string"
        },
        "session_id": {
          "default": "sess_default",
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChatUserInputPayload",
      "type": "object"
    },
    "EmotionCausePayload": {
      "$defs": {
        "PADPayload": {
          "properties": {
            "arousal": {
              "title": "Arousal",
              "type": "number"
            },
            "dominance": {
              "title": "Dominance",
              "type": "number"
            },
            "valence": {
              "title": "Valence",
              "type": "number"
            }
          },
          "required": [
            "valence",
            "arousal",
            "dominance"
          ],
          "title": "PADPayload",
          "type": "object"
        }
      },
      "properties": {
        "delta": {
          "$ref": "#/$defs/PADPayload"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "resulting_label": {
          "title": "Resulting Label",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stimulus": {
          "title": "Stimulus",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "ts",
        "source",
        "stimulus",
        "delta",
        "resulting_label"
      ],
      "title": "EmotionCausePayload",
      "type": "object"
    },
    "EmotionUpdatePayload": {
      "$defs": {
        "EmotionCausePayload": {
          "properties": {
            "delta": {
              "$ref": "#/$defs/PADPayload"
            },
            "note": {
              "default": "",
              "title": "Note",
              "type": "string"
            },
            "resulting_label": {
              "title": "Resulting Label",
              "type": "string"
            },
            "source": {
              "title": "Source",
              "type": "string"
            },
            "stimulus": {
              "title": "Stimulus",
              "type": "string"
            },
            "ts": {
              "title": "Ts",
              "type": "number"
            }
          },
          "required": [
            "ts",
            "source",
            "stimulus",
            "delta",
            "resulting_label"
          ],
          "title": "EmotionCausePayload",
          "type": "object"
        },
        "PADPayload": {
          "properties": {
            "arousal": {
              "title": "Arousal",
              "type": "number"
            },
            "dominance": {
              "title": "Dominance",
              "type": "number"
            },
            "valence": {
              "title": "Valence",
              "type": "number"
            }
          },
          "required": [
            "valence",
            "arousal",
            "dominance"
          ],
          "title": "PADPayload",
          "type": "object"
        }
      },
      "description": "``emotion.update``：后端权威情绪快照（不变量 I1）。",
      "properties": {
        "affinity": {
          "default": 0.0,
          "title": "Affinity",
          "type": "number"
        },
        "causes": {
          "items": {
            "$ref": "#/$defs/EmotionCausePayload"
          },
          "title": "Causes",
          "type": "array"
        },
        "idle_seconds": {
          "default": 0.0,
          "title": "Idle Seconds",
          "type": "number"
        },
        "intensity": {
          "title": "Intensity",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "label_changed": {
          "default": false,
          "title": "Label Changed",
          "type": "boolean"
        },
        "label_confidence": {
          "default": 1.0,
          "title": "Label Confidence",
          "type": "number"
        },
        "mood": {
          "$ref": "#/$defs/PADPayload"
        },
        "mood_label": {
          "default": "content",
          "title": "Mood Label",
          "type": "string"
        },
        "pad": {
          "$ref": "#/$defs/PADPayload"
        },
        "patience": {
          "default": 1.0,
          "title": "Patience",
          "type": "number"
        },
        "pending_greeting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Greeting"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "secondary_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Label"
        },
        "trust": {
          "default": 0.0,
          "title": "Trust",
          "type": "number"
        },
        "ts": {
          "default": 0.0,
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "pad",
        "label",
        "intensity",
        "mood"
      ],
      "title": "EmotionUpdatePayload",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "所有 WS 文本消息的统一信封（计划书 6.2）。\n\n六个字段在**线格式上全部必填**（``turn_id`` 允许为 null），\n这样导出的 JSON Schema 不会把 ``id`` / ``ts`` 误标为可选。\n发送侧请用 :func:`build_envelope` 构造。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "v": {
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "id",
        "ts",
        "payload"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "InteractionEventPayload": {
      "description": "前端上报的交互事件（计划书 5.6.6）。\n\n``type`` 即刺激标签（pat_head / touch_face / poke_body / teased / dragged），\nS3 的情感引擎把它转成刺激；S2 只做接收与日志。",
      "properties": {
        "area": {
          "default": "body",
          "title": "Area",
          "type": "string"
        },
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "type": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "title": "InteractionEventPayload",
      "type": "object"
    },
    "MessageType": {
      "enum": [
        "sys.hello",
        "sys.hello_ack",
        "sys.ping",
        "sys.pong",
        "sys.error",
        "sys.status",
        "chat.user_input",
        "chat.agent_delta",
        "chat.agent_final",
        "chat.interrupt",
        "performance.cue",
        "interaction.event",
        "emotion.update",
        "proactive.speak",
        "audio.in_begin",
        "audio.in_chunk",
        "audio.in_end",
        "audio.out_begin",
        "audio.out_chunk",
        "audio.out_end",
        "audio.stop",
        "asr.partial",
        "asr.final",
        "asr.error"
      ],
      "title": "MessageType",
      "type": "string"
    },
    "PADPayload": {
      "properties": {
        "arousal": {
          "title": "Arousal",
          "type": "number"
        },
        "dominance": {
          "title": "Dominance",
          "type": "number"
        },
        "valence": {
          "title": "Valence",
          "type": "number"
        }
      },
      "required": [
        "valence",
        "arousal",
        "dominance"
      ],
      "title": "PADPayload",
      "type": "object"
    },
    "PerformanceCuePayload": {
      "properties": {
        "auto_release_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auto Release Ms"
        },
        "emotion_label": {
          "title": "Emotion Label",
          "type": "string"
        },
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "expression_weight": {
          "default": 1.0,
          "title": "Expression Weight",
          "type": "number"
        },
        "motion": {
          "title": "Motion",
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "priority": {
          "default": "normal",
          "title": "Priority",
          "type": "string"
        },
        "secondary_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Expression"
        },
        "secondary_weight": {
          "default": 0.0,
          "title": "Secondary Weight",
          "type": "number"
        },
        "style_hints": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Hints"
        },
        "tts": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts"
        }
      },
      "required": [
        "emotion_label",
        "motion"
      ],
      "title": "PerformanceCuePayload",
      "type": "object"
    },
    "ProactiveSpeakPayload": {
      "description": "主动搭话（文案来自角色卡模板）。",
      "properties": {
        "emotion_label": {
          "title": "Emotion Label",
          "type": "string"
        },
        "kind": {
          "default": "lonely",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "emotion_label"
      ],
      "title": "ProactiveSpeakPayload",
      "type": "object"
    },
    "SysErrorPayload": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code"
      ],
      "title": "SysErrorPayload",
      "type": "object"
    },
    "SysHelloAckPayload": {
      "description": "握手响应，含全量状态快照（S0 只含版本与时间）。",
      "properties": {
        "emotion": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotion"
        },
        "protocol": {
          "default": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "server_time": {
          "title": "Server Time",
          "type": "number"
        },
        "server_version": {
          "title": "Server Version",
          "type": "string"
        }
      },
      "required": [
        "server_version",
        "server_time"
      ],
      "title": "SysHelloAckPayload",
      "type": "object"
    },
    "SysPongPayload": {
      "properties": {
        "echo_ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Echo Ts"
        },
        "server_time": {
          "title": "Server Time",
          "type": "number"
        }
      },
      "required": [
        "server_time"
      ],
      "title": "SysPongPayload",
      "type": "object"
    }
  },
  "$id": "https://mochi.local/schema/protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocolVersion": 1,
  "title": "Mochi WS Protocol"
}
