# ══════ 服务（S0）══════
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
SERVER_TOKEN=              # 留空则不校验；发布版由 Tauri 启动时随机生成
DATA_DIR=                  # 留空则用 %APPDATA%/Mochi
LOG_LEVEL=INFO

# ══════ LLM（S1 起使用，OpenAI 兼容协议）══════
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_CHAT=deepseek-chat
LLM_MODEL_DECISION=deepseek-chat
LLM_MODEL_SUMMARY=deepseek-chat
LLM_TEMPERATURE_ROLEPLAY=0.85
LLM_TEMPERATURE_DECISION=0.0
LLM_TIMEOUT_SECONDS=20

# ══════ 角色（S1 起使用）══════
CHARACTER=tsundere

# ══════ 语音（S4）══════
VOICE_ENABLED=true
VOICE_INPUT_MODE=push_to_talk
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_VOLUME=0.9
ASR_ENABLED=true
ASR_MODEL=tiny
ASR_LANGUAGE=zh
ASR_COMPUTE_TYPE=int8
ASR_INITIAL_PROMPT=以下是桌宠和用户的普通话对话。
VOICE_MAX_UTTERANCE_SECONDS=30
